% Internal span transport. Public shape/hex APIs retain their complete decoder.
% The strict decoder writes word records during its single validation pass.
% Nothing is shaped/rendered until that entire pass succeeds. Record names are
% locally assigned, reused between calls and bounded by at most 2048 words.
\seq_new:N\l__bn_span_words_seq
\tl_new:N\l__bn_span_word_tl
\int_new:N\l__bn_span_at_int
