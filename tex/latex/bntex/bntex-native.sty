    \seq_set_eq:cN{l__bn_span_\int_use:N\l__bn_span_count_int _offsets_seq}\l_bntex_utfviii_offsets_seq
    \seq_set_eq:cN{l__bn_span_\int_use:N\l__bn_span_count_int _lengths_seq}\l_bntex_utfviii_lengths_seq
    \seq_clear:N\l_bntex_utfviii_scalars_seq
    \seq_clear:N\l_bntex_utfviii_offsets_seq
    \seq_clear:N\l_bntex_utfviii_lengths_seq
    \int_zero:N\l__bn_span_at_int}}
