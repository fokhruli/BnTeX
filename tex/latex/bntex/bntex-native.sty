\cs_new_protected:Npn\__bn_span_collect:
 {\int_compare:nNnTF{\l__bntex_utfviii_value_int}={32}{\__bn_span_save:}
   {\seq_put_right:Nx\l_bntex_utfviii_scalars_seq{\int_use:N\l__bntex_utfviii_value_int}
