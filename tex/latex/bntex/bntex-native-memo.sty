\NeedsTeXFormat{LaTeX2e}[2022-06-01]
\RequirePackage{bntex-native}
\ProvidesExplPackage{bntex-native-memo}{2026-09-24}{0.1.0}{Bounded native glyph-run memoization}
\cs_if_exist:NF \__bn_shape_word:n {\__bn_fail:n{matching~native~decoded-word~hook~is~required}}
\prop_new:N \g__bnm_runs_prop
\tl_new:N \l__bnm_key_tl
\tl_new:N \l__bnm_run_tl
\bool_new:N \g__bnm_enabled_bool
\int_new:N \g__bnm_hits_int
\int_new:N \g__bnm_misses_int
\int_new:N \g__bnm_evictions_int
\int_new:N \g__bnm_glyphs_int
\int_new:N \g__bnm_limit_int
\int_gset:Nn \g__bnm_limit_int {256}
\bool_gset_true:N \g__bnm_enabled_bool
\cs_new_protected:Npn \__bnm_clear:
  {\prop_gclear:N \g__bnm_runs_prop\int_gzero:N \g__bnm_glyphs_int}
\NewDocumentCommand \BnTeXNativeMemoClear {}
  {\__bnm_clear:\int_gzero:N\g__bnm_hits_int\int_gzero:N\g__bnm_misses_int\int_gzero:N\g__bnm_evictions_int}
\NewDocumentCommand \BnTeXNativeMemoOn {}{\bool_gset_true:N\g__bnm_enabled_bool}
\NewDocumentCommand \BnTeXNativeMemoOff {}{\bool_gset_false:N\g__bnm_enabled_bool\__bnm_clear:}
\NewDocumentCommand \BnTeXNativeMemoLimit {m}
  {\regex_match:nnTF{\A[0-9]{1,3}\Z}{#1}
    {\int_compare:nNnTF{#1}<{1}{\__bn_fail:n{memo~limit~must~be~1--256}}
      {\int_compare:nNnTF{#1}>{256}{\__bn_fail:n{memo~limit~must~be~1--256}}
        {\int_gset:Nn\g__bnm_limit_int{#1}\__bnm_clear:}}}
    {\__bn_fail:n{memo~limit~must~be~1--256}}}
\NewDocumentCommand \BnTeXNativeMemoStats {}
  {\iow_term:x{BNTEX-MEMO|hits=\int_use:N\g__bnm_hits_int|misses=\int_use:N\g__bnm_misses_int|entries=\prop_count:N\g__bnm_runs_prop|glyphs=\int_use:N\g__bnm_glyphs_int|evictions=\int_use:N\g__bnm_evictions_int}}
\cs_new_protected:Npn \__bnm_store:
  {\int_compare:nNnT{\g__bn_count_int}<{129}
    {\bool_if:nT
       {\int_compare_p:n{\prop_count:N\g__bnm_runs_prop>=\g__bnm_limit_int}||
        \int_compare_p:n{\g__bnm_glyphs_int+\g__bn_count_int>8192}}
       {\__bnm_clear:\int_gincr:N\g__bnm_evictions_int}
     \tl_set:Nx\l__bnm_run_tl
       {\exp_not:N\int_gset:Nn\exp_not:N\g__bn_count_int{\int_use:N\g__bn_count_int}
        \exp_not:N\int_gset:Nn\exp_not:N\g__bn_allocated_int{\int_use:N\g__bn_count_int}
        \exp_not:N\int_gzero:N\exp_not:N\g__bn_ops_int
        \exp_not:N\tl_gset:Nn\exp_not:N\g__bn_original_hex_tl{\exp_not:V\g__bn_original_hex_tl}
        \exp_not:N\tl_gset:Nn\exp_not:N\g__bn_utf_sixteen_tl{\exp_not:V\g__bn_utf_sixteen_tl}}
     \int_step_inline:nnnn{0}{1}{\g__bn_count_int-1}
       {\tl_put_right:Nx\l__bnm_run_tl
          {\exp_not:N\intarray_gset:Nnn\exp_not:N\g__bn_order_intarray{\int_eval:n{##1+1}}{\int_eval:n{##1+1}}}
        \clist_map_inline:nn{gid,cl,ax,ay,dx,dy,unsafe}
          {\tl_put_right:Nx\l__bnm_run_tl
            {\exp_not:N\__bn_setid:nnn{\int_eval:n{##1+1}}{####1}{\__bn_get:nn{##1}{####1}}}}}
     \prop_gput:NVV\g__bnm_runs_prop\l__bnm_key_tl\l__bnm_run_tl
     \int_gadd:Nn\g__bnm_glyphs_int{\g__bn_count_int}}}
\cs_new_protected:Npn \__bnm_word:n #1
  {\bool_if:NF\g__bn_loaded_bool{\__bn_fail:n{load~a~native~profile~first}}
   \bool_if:NT\g__bn_busy_bool{\__bn_fail:n{nested~native~shaping~is~unsupported}}
   \bool_if:nTF{\g__bnm_enabled_bool && !\g__bn_trace_bool}
    {\group_begin:
     % Exact original bytes, not MD5 and not normalized text. One immutable
     % profile/configuration per document; no size/color in this glyph-unit IR.
     \tl_set:Nx\l__bnm_key_tl{\pdfescapehex{\detokenize{#1}}}
     \prop_get:NVNTF\g__bnm_runs_prop\l__bnm_key_tl\l__bnm_run_tl
       {\int_gincr:N\g__bnm_hits_int\tl_use:N\l__bnm_run_tl}
       {\int_gincr:N\g__bnm_misses_int\__bn_shape_word:n{#1}\__bnm_store:}
     \__bn_render:\group_end:}
    {\__bn_shape_word:n{#1}\__bn_render:}}
\cs_set_eq:NN\__bn_typeset_word:n\__bnm_word:n
\ExplSyntaxOff
\endinput
