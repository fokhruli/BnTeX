%% BnTeX public installed-package entry point. Copyright 2026; MIT.
\NeedsTeXFormat{LaTeX2e}[2022-06-01]
\ProvidesPackage{bntex}[2026/09/26 v0.2.0-alpha Installed automatic Bengali for pdfLaTeX]
\newif\ifbntex@legacy
\newif\ifbntex@slant
\DeclareOption{cached}{\bntex@legacytrue}
\DeclareOption{synthetic-italic}{\bntex@slanttrue}
\DeclareOption*{\PackageError{bntex}{Unknown option \CurrentOption}
  {Supported options are cached and synthetic-italic.}}
\ProcessOptions\relax
\ifbntex@legacy
  \ifbntex@slant
    \PackageError{bntex}{synthetic-italic is not a cached-backend option}
      {Choose the native installed package or prepare an explicit cached style.}
  \fi
  \RequirePackage{bntex-cached}
\else
  \ifbntex@slant\PassOptionsToPackage{synthetic-italic}{bntex-auto}\fi
  \RequirePackage{bntex-auto}
  \RequirePackage{bntex-distribution}
  \IfFileExists{bntex-default-profile.def}
    {\BnTeXNativeLoadProfile{bntex-default-profile.def}}
    {\PackageError{bntex}{The installed default font profile is missing}
      {Install the complete BnTeX distribution, not just its .sty source.
       Legacy prepared documents must explicitly select [cached].}}
\fi
\endinput
